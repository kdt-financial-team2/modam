# ==========================================
# MODAM 환경변수 예시 파일
# ==========================================
# 사용 방법:
#   1. 이 파일을 복사해서 .env 파일을 만드세요.
#      cp .env.example .env   (Linux/Mac)
#      copy .env.example .env (Windows)
#   2. 각 항목에 본인 환경에 맞는 값을 입력하세요.
#   3. .env 파일은 절대 Git에 커밋하지 마세요!

# ------------------------------------------
# 실행 프로파일 (dev = H2 인메모리 / prod = Oracle)
# ------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------
# 서버 설정
# ------------------------------------------
APP_PORT=8080
APP_BASE_URL=http://localhost:8080

# ------------------------------------------
# Oracle DB 설정
# ------------------------------------------
# Oracle DB 접속 URL (호스트, 포트, SID 확인 후 입력)
DB_URL=jdbc:oracle:thin:@localhost:1521/XEPDB1
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ------------------------------------------
# Spring Security 기본 계정 (개발용)
# ------------------------------------------
SECURITY_USER_NAME=test
SECURITY_USER_PASSWORD=your_security_password

# ------------------------------------------
# Gmail SMTP 설정
# ------------------------------------------
# Gmail 주소 및 앱 비밀번호 입력
# 앱 비밀번호 발급: Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password
